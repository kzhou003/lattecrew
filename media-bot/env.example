OWNER_ID=U0XXXXXXXXX
# Who else may use the bots: * = every member of this workspace, or a comma list of user IDs. Empty = owner only.
ALLOWED_USERS=*
# Per-person daily limits for non-owners (the owner is unlimited).
DAILY_LIMITS=image=30,speech=30,wan=3,chat=100
Z_IMAGE_BOT_TOKEN=xoxb-...
Z_IMAGE_APP_TOKEN=xapp-...
QWEN_TTS_BOT_TOKEN=xoxb-...
QWEN_TTS_APP_TOKEN=xapp-...
WAN_BOT_TOKEN=xoxb-...
WAN_APP_TOKEN=xapp-...
QWEN_CHAT_BOT_TOKEN=xoxb-...
QWEN_CHAT_APP_TOKEN=xapp-...
# Long-term memory for @qwen-chat (Mem0 + Qdrant on 127.0.0.1:6333). off = no memory.
QWEN_CHAT_MEMORY=on
